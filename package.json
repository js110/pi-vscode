{
  "name": "pi-vscode",
  "displayName": "Pi for VS Code",
  "description": "A first-class VS Code interface powered by the native Pi coding agent SDK.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/js110/pi-vscode.git"
  },
  "homepage": "https://github.com/js110/pi-vscode#readme",
  "bugs": {
    "url": "https://github.com/js110/pi-vscode/issues"
  },
  "icon": "media/pi-icon-full.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pi-agent",
          "title": "Pi Agent",
          "icon": "media/pi-icon.svg"
        }
      ]
    },
    "views": {
      "pi-agent": [
        {
          "type": "webview",
          "id": "pi-agent.chat",
          "name": "Pi Agent"
        }
      ]
    },
    "commands": [
      {
        "command": "pi-agent.newChat",
        "title": "Pi: New Chat"
      },
      {
        "command": "pi-agent.abort",
        "title": "Pi: Stop Generation"
      },
      {
        "command": "pi-agent.selectModel",
        "title": "Pi: Select Model"
      },
      {
        "command": "pi-agent.toggleThinking",
        "title": "Pi: Toggle Thinking Level"
      },
      {
        "command": "pi-agent.compact",
        "title": "Pi: Compact Context"
      },
      {
        "command": "pi-agent.focusChat",
        "title": "Pi: Focus Chat"
      },
      {
        "command": "pi-agent.openSettings",
        "title": "Pi: Open Settings"
      },
      {
        "command": "pi-agent.moveToSecondarySidebar",
        "title": "Pi: Move Panel to Secondary Sidebar (Right)"
      },
      {
        "command": "pi-agent.moveToPrimarySidebar",
        "title": "Pi: Move Panel to Primary Sidebar (Left)"
      }
    ],
    "keybindings": [
      {
        "command": "pi-agent.focusChat",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l"
      },
      {
        "command": "pi-agent.newChat",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n"
      },
      {
        "command": "pi-agent.abort",
        "key": "escape",
        "when": "pi-agent.isStreaming"
      }
    ],
    "configuration": {
      "title": "Pi Agent",
      "properties": {
        "pi-agent.apiProvider": {
          "type": "string",
          "default": "",
          "description": "Preferred AI provider (e.g. anthropic, openai, google, deepseek). Leave empty for automatic detection."
        },
        "pi-agent.defaultModel": {
          "type": "string",
          "default": "",
          "description": "Default model ID to use when starting new sessions (e.g. claude-sonnet-4-20250514). Leave empty for automatic selection."
        },
        "pi-agent.thinkingLevel": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "minimal",
            "low",
            "medium",
            "high"
          ],
          "description": "Default thinking level for Pi agent responses"
        },
        "pi-agent.autoApproveTools": {
          "type": "boolean",
          "default": false,
          "description": "Automatically approve tool executions without confirmation"
        },
        "pi-agent.allowedTools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Restrict which tools the agent can use. Leave empty to allow all tools."
        },
        "pi-agent.autoSaveSessions": {
          "type": "boolean",
          "default": true,
          "description": "Automatically persist sessions"
        },
        "pi-agent.sessionStoragePath": {
          "type": "string",
          "default": "",
          "description": "Custom path for session storage. Leave empty to use the default workspace .pi/ directory."
        },
        "pi-agent.contextUsageWarningThreshold": {
          "type": "number",
          "default": 80,
          "minimum": 0,
          "maximum": 100,
          "description": "Show a warning when context usage exceeds this percentage of the context window"
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && node scripts/check-pi-api.mjs && npm run compile && npm run test:unit",
    "package": "npx @vscode/vsce package --allow-missing-repository --no-rewrite-relative-links",
    "test": "vitest",
    "test:unit": "vitest run",
    "compile:test": "tsc -p tsconfig.test.json",
    "test:integration": "npm run compile && npm run compile:test && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-local-vscode-tests.ps1",
    "test:all": "npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "marked": "^18.0.11"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.4.0",
    "@types/vscode": "^1.134.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.0",
    "mocha": "^12.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
